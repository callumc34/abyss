new file mode 100644
index 0000000..b4c078f
--- /dev/null
+++ b/include/abyss/engine/diag_slow.h
@@ -0,0 +1,17 @@
+#pragma once
+
+// DIAG (3-4 W1 root cause, never committed).
+#include <array>
+#include <cstdint>
+#include <vector>
+
+namespace abyss::engine {
+
+struct DiagSlowWrite {
+  int64_t at_ns = 0;
+  std::array<int64_t, 9> stage_ns{};
+};
+
+std::vector<DiagSlowWrite> DiagSlowWrites();
+
+}  // namespace abyss::engine
