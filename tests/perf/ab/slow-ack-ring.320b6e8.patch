 // One write in 64 on average is timed, picked at random per thread: a
 // fixed stride could line up with frames on a page, and no writer
 // touches a shared cache line to decide.
+bool DiagUnsampled() {
+  static const bool on = std::getenv("ABYSS_DIAG_UNSAMPLED") != nullptr;
+  return on;
+}
+std::mutex g_diag_mu;
+std::vector<DiagSlowWrite> g_diag_slow;
+
 bool Sampled() {
+  if (DiagUnsampled()) return true;
   thread_local uint64_t t_state = 0;
   if (t_state == 0) {
     uint64_t seed =
@@ -176,6 +189,20 @@ class Sequencer::Phases {
       sequencer_.phase_seconds_.at(i).Observe(
           std::chrono::duration<double>(times_.spent.at(i)).count());
     }
+    if (!DiagUnsampled()) return;
+    std::chrono::steady_clock::duration total{};
+    for (const auto d : times_.spent) total += d;
+    if (total < std::chrono::milliseconds{1}) return;
+    DiagSlowWrite slow;
+    slow.at_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                     std::chrono::steady_clock::now().time_since_epoch())
+                     .count();
+    for (size_t i = 0; i < times_.spent.size() && i < slow.stage_ns.size(); ++i) {
+      slow.stage_ns.at(i) =
+          std::chrono::duration_cast<std::chrono::nanoseconds>(times_.spent.at(i)).count();
+    }
+    const std::scoped_lock lock(g_diag_mu);
+    if (g_diag_slow.size() < 1000000) g_diag_slow.push_back(slow);
   }

  private:
@@ -1026,4 +1053,9 @@ SequencerStats Sequencer::Snapshot() const {
   return stats;
 }

+std::vector<DiagSlowWrite> DiagSlowWrites() {
+  const std::scoped_lock lock(g_diag_mu);
+  return g_diag_slow;
+}
+
 }  // namespace abyss::engine
