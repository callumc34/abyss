{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ABYSS_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold"
      }
    },
    {
      "name": "release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABYSS_BUILD_TESTS": "OFF",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold"
      }
    },
    {
      "name": "asan",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "tsan",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "bench",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABYSS_BUILD_TESTS": "OFF",
        "ABYSS_BUILD_BENCHMARKS": "ON",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold;benchmarks"
      }
    },
    {
      "name": "cloud-only",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ABYSS_BUILD_TESTS": "ON",
        "ABYSS_WITH_ROCKSDB": "OFF"
      }
    },
    {
      "name": "container",
      "inherits": "release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "ABYSS_WERROR": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-static-release",
        "VCPKG_HOST_TRIPLET": "x64-linux-static-release",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_EXE_LINKER_FLAGS": "-static-libstdc++ -static-libgcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "cloud-only",
      "configurePreset": "cloud-only"
    },
    {
      "name": "container",
      "configurePreset": "container"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 30,
        "stopOnFailure": false
      }
    },
    {
      "name": "cloud-only",
      "configurePreset": "cloud-only",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 30
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 300
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 300
      }
    }
  ]
}
