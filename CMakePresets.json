{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ABYSS_BUILD_TESTS": "ON",
        "ABYSS_BUILD_PERF": "ON",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold;perf"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABYSS_BUILD_TESTS": "OFF",
        "ABYSS_BUILD_PERF": "OFF",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold"
      }
    },
    {
      "name": "asan",
      "inherits": "default",
      "cacheVariables": {
        "ABYSS_SANITIZER": "address+undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "default",
      "cacheVariables": {
        "ABYSS_SANITIZER": "thread",
        "ABYSS_BUILD_PERF": "OFF",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold"
      }
    },
    {
      "name": "ubsan",
      "inherits": "default",
      "cacheVariables": {
        "ABYSS_SANITIZER": "undefined",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g"
      }
    },
    {
      "name": "bench",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABYSS_BUILD_TESTS": "ON",
        "ABYSS_BUILD_BENCHMARKS": "ON",
        "ABYSS_BUILD_PERF": "ON",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold;benchmarks;perf"
      }
    },
    {
      "name": "cloud-only",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ABYSS_BUILD_TESTS": "ON",
        "ABYSS_WITH_ROCKSDB": "OFF"
      }
    },
    {
      "name": "container",
      "inherits": "release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "ABYSS_WERROR": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-static-release",
        "VCPKG_HOST_TRIPLET": "x64-linux-static-release",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_EXE_LINKER_FLAGS": "-static-libstdc++ -static-libgcc"
      }
    },
    {
      "name": "macos",
      "inherits": "default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "inherits": "default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABYSS_WERROR": "ON",
        "ABYSS_BUILD_PERF": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-release",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_MANIFEST_FEATURES": "builtin-cold"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "bench", "configurePreset": "bench" },
    { "name": "cloud-only", "configurePreset": "cloud-only" },
    { "name": "container", "configurePreset": "container" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "windows", "configurePreset": "windows" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 8,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 30,
        "stopOnFailure": false
      },
      "filter": {
        "exclude": { "label": "perf-micro|perf-probe|perf-load" }
      }
    },
    {
      "name": "cloud-only",
      "configurePreset": "cloud-only",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 8,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 30
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 300
      },
      "filter": {
        "exclude": { "label": "perf-micro|perf-probe|perf-load" }
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 300
      },
      "filter": {
        "exclude": { "label": "perf-micro|perf-probe|perf-load" }
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 4,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": { "label": "perf-micro|perf-probe|perf-load" }
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 8,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 180
      },
      "filter": {
        "exclude": { "label": "perf-micro|perf-probe|perf-load" }
      }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 4,
        "scheduleRandom": true,
        "noTestsAction": "error",
        "timeout": 180
      }
    }
  ]
}
