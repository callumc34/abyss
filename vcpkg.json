{
  "name": "abyss",
  "version": "0.1.0",
  "description": "Redis-compatible hot-cold tiered KV store",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "cli11",
    "cpp-httplib",
    "crc32c",
    "prometheus-cpp",
    "spdlog",
    "xxhash",
    "yaml-cpp"
  ],
  "features": {
    "builtin-cold": {
      "description": "Build the built-in RocksDB cold store backend",
      "dependencies": [
        "rocksdb"
      ]
    },
    "benchmarks": {
      "description": "Build micro-benchmarks",
      "dependencies": [
        "benchmark"
      ]
    },
    "perf": {
      "description": "Build the performance harness (probes, load generator, framework)",
      "dependencies": [
        "hiredis",
        {
          "name": "hdr-histogram",
          "features": [
            "log"
          ]
        }
      ]
    },
    "tests": {
      "description": "Build the unit, component, integration and system test suites",
      "dependencies": [
        "gtest"
      ]
    }
  }
}